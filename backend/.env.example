# Copy to .env (or .env.local) and fill in your values.
# Prisma CLI reads env via prisma.config.ts — not the default Prisma .env loader.
#
# Local (docker compose up -d in backend/):
# DATABASE_URL="postgresql://mini_vercel:mini_vercel@localhost:5432/mini_vercel"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="replace-with-a-long-random-secret"

BACKEND_URL="http://localhost:8080"
FRONTEND_URL="http://localhost:3000"
GITHUB_CLIENT_ID="github-oauth-client-id"
GITHUB_CLIENT_SECRET="github-oauth-client-secret"
GITHUB_APP_ID="github-app-id"
GITHUB_APP_SLUG="github-app-slug"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET="replace-with-a-webhook-secret"
GITHUB_TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-secret"
